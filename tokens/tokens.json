{
  "$description": "Token desain Sistem POS Toko Budiannor. Acuan: Spesifikasi Desain UI/UX v1.0 Bagian 4 dan prompt proyek. Keterangan sumber: klien (tanpa tanda), usulan, asumsi (dicatat di docs/asumsi.md).",
  "$apps": {
    "profiles": { "pos": ["pos"], "bo": ["bo", "portal"], "owner": ["owner", "sales"] },
    "dark": ["owner"]
  },
  "$themes": {
    "$description": "Tema POS: menimpa nilai terang ($value) dan permukaan gelap ($dark) token aksen. terakota kosong berarti palet bawaan. $contexts membatasi konteks yang diperiksa kontras.",
    "oranye": {
      "semantic.color.accent.default": { "$value": "#B94F00", "$dark": "#F0A15C" },
      "semantic.color.accent.pressed": { "$value": "#8F3C00", "$dark": "#F0A15C" },
      "semantic.color.accent.soft": { "$value": "#FBE9D9", "$dark": "#3A2A1E" }
    },
    "terakota": {},
    "teal": {
      "semantic.color.accent.default": { "$value": "#0F766E", "$dark": "#5CC8BE" },
      "semantic.color.accent.pressed": { "$value": "#0B5A54", "$dark": "#5CC8BE" },
      "semantic.color.accent.soft": { "$value": "#D9F0EE", "$dark": "#1E3331" }
    },
    "gelap": {
      "$contexts": ["dark"],
      "semantic.color.accent.default": { "$value": "#E8836A", "$dark": "#E8836A" },
      "semantic.color.accent.pressed": { "$value": "#E8836A", "$dark": "#E8836A" },
      "semantic.color.accent.soft": { "$value": "#2B2E33", "$dark": "#2B2E33" }
    }
  },
  "primitive": {
    "color": {
      "$type": "color",
      "white": "#FFFFFF",
      "cream": { "50": "#F6F4F0", "100": "#EFEAE0", "200": "#E2DDD4" },
      "ink": { "900": "#1C2024", "600": "#5F6670" },
      "terracotta": { "700": "#963A22", "600": "#B4472B", "300": "#E8836A", "100": "#F5E3DD" },
      "green": { "700": "#1F7A4D", "50": "#E4F2EA" },
      "amber": { "800": "#8A5200", "50": "#FBF0DC" },
      "red": { "700": "#B3261E", "50": "#FBE9E7" },
      "night": { "950": "#16181B", "900": "#1E2126", "800": "#2B2E33", "100": "#ECE8E1" },
      "slate": { "400": "#9AA0A6" }
    },
    "space": { "$type": "dimension", "1": 4, "2": 8, "3": 12, "4": 16, "6": 24, "8": 32, "12": 48 },
    "radius": { "$type": "dimension", "sm": 6, "md": 8, "lg": 12, "full": 999 },
    "font-size": {
      "$type": "dimension",
      "12": 12,
      "13": 13,
      "14": 14,
      "16": 16,
      "18": 18,
      "20": 20,
      "22": 22,
      "24": 24,
      "32": 32
    },
    "font-weight": {
      "$type": "fontWeight",
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "line-height": {
      "$type": "number",
      "120": 1.2,
      "130": 1.3,
      "135": 1.35,
      "140": 1.4,
      "150": 1.5
    },
    "font-family": {
      "$type": "fontFamily",
      "sans": ["IBM Plex Sans", "system-ui", "Segoe UI", "Roboto", "Arial", "sans-serif"]
    },
    "duration": { "$type": "duration", "fast": 150, "toast": 4000 }
  },
  "semantic": {
    "color": {
      "$type": "color",
      "bg": {
        "page": {
          "$value": "{primitive.color.cream.50}",
          "$dark": "{primitive.color.night.950}",
          "$description": "Latar halaman"
        },
        "surface": {
          "$value": "{primitive.color.white}",
          "$dark": "{primitive.color.night.900}",
          "$description": "Permukaan: kartu, panel, modal, kolom input",
          "$source": "asumsi (nilai gelap)"
        },
        "table-header": {
          "$value": "{primitive.color.cream.100}",
          "$dark": "{primitive.color.night.800}",
          "$description": "Latar header tabel",
          "$source": "asumsi (nilai gelap)"
        },
        "selected": {
          "$value": "{primitive.color.cream.50}",
          "$dark": "{primitive.color.night.900}",
          "$description": "Latar baris tabel terpilih",
          "$source": "asumsi (nilai gelap)"
        },
        "pressed": {
          "$value": "{primitive.color.cream.50}",
          "$dark": "{primitive.color.night.900}",
          "$description": "Latar tombol sekunder saat ditekan",
          "$source": "asumsi (nilai gelap)"
        },
        "disabled": {
          "$value": "{primitive.color.cream.200}",
          "$dark": "{primitive.color.night.800}",
          "$description": "Latar tombol nonaktif",
          "$source": "asumsi (nilai gelap)"
        },
        "overlay": {
          "$value": "{primitive.color.ink.900}",
          "$alpha": 0.4,
          "$description": "Latar peredam di belakang modal, 40 persen",
          "$source": "usulan"
        }
      },
      "text": {
        "primary": {
          "$value": "{primitive.color.ink.900}",
          "$dark": "{primitive.color.night.100}",
          "$description": "Judul, isi, angka"
        },
        "secondary": {
          "$value": "{primitive.color.ink.600}",
          "$dark": "{primitive.color.slate.400}",
          "$description": "Label, keterangan, placeholder"
        },
        "on-accent": {
          "$value": "{primitive.color.white}",
          "$dark": "{primitive.color.night.950}",
          "$description": "Teks di atas warna aksen",
          "$source": "asumsi (nilai gelap)"
        }
      },
      "border": {
        "default": {
          "$value": "{primitive.color.cream.200}",
          "$dark": "{primitive.color.night.800}",
          "$description": "Garis tabel dan batas kartu",
          "$source": "asumsi (nilai gelap)"
        }
      },
      "accent": {
        "default": {
          "$value": "{primitive.color.terracotta.600}",
          "$dark": "{primitive.color.terracotta.300}",
          "$description": "Aksen aksi utama dan tautan aktif"
        },
        "pressed": {
          "$value": "{primitive.color.terracotta.700}",
          "$dark": "{primitive.color.terracotta.300}",
          "$description": "Keadaan ditekan tombol utama",
          "$source": "usulan; nilai gelap asumsi"
        },
        "soft": {
          "$value": "{primitive.color.terracotta.100}",
          "$dark": "{primitive.color.night.800}",
          "$description": "Latar lembut aksen: baris terpilih dan chip lembut",
          "$source": "usulan (revisi POS November 2026)"
        }
      },
      "focus": {
        "ring": {
          "$value": "{primitive.color.ink.900}",
          "$dark": "{primitive.color.night.100}",
          "$description": "Cincin fokus",
          "$source": "usulan; nilai gelap asumsi"
        }
      },
      "status": {
        "success": {
          "fg": { "$value": "{primitive.color.green.700}", "$description": "Teks dan ikon sukses" },
          "bg": {
            "$value": "{primitive.color.green.50}",
            "$description": "Latar toast dan chip sukses",
            "$source": "usulan"
          }
        },
        "warning": {
          "fg": { "$value": "{primitive.color.amber.800}", "$description": "Teks peringatan" },
          "bg": {
            "$value": "{primitive.color.amber.50}",
            "$description": "Latar banner peringatan"
          }
        },
        "danger": {
          "fg": {
            "$value": "{primitive.color.red.700}",
            "$description": "Teks error dan tombol hapus"
          },
          "bg": {
            "$value": "{primitive.color.red.50}",
            "$description": "Latar banner error",
            "$source": "usulan"
          }
        }
      }
    },
    "space": {
      "$type": "dimension",
      "card-padding": { "$value": "{primitive.space.4}", "$description": "Padding kartu" },
      "screen-margin": {
        "$app": {
          "pos": "{primitive.space.4}",
          "bo": "{primitive.space.6}",
          "owner": "{primitive.space.4}"
        },
        "$description": "Margin tepi layar"
      },
      "touch-gap": {
        "$value": "{primitive.space.2}",
        "$description": "Jarak minimal antar target sentuh"
      }
    },
    "size": {
      "$type": "dimension",
      "touch-target-min": {
        "$value": 48,
        "$description": "Target sentuh minimal 48 x 48",
        "$source": "usulan"
      }
    },
    "radius": {
      "$type": "dimension",
      "control": { "$value": "{primitive.radius.sm}", "$description": "Input dan tombol" },
      "card": { "$value": "{primitive.radius.md}", "$description": "Kartu dan panel" },
      "modal": { "$value": "{primitive.radius.lg}", "$description": "Modal" },
      "chip": { "$value": "{primitive.radius.full}", "$description": "Chip dan lencana" }
    },
    "focus": {
      "$type": "dimension",
      "ring-width": { "$value": 3, "$description": "Tebal cincin fokus", "$source": "usulan" },
      "ring-offset": { "$value": 2, "$description": "Jarak cincin fokus", "$source": "usulan" }
    },
    "motion": {
      "$type": "duration",
      "fast": {
        "$value": "{primitive.duration.fast}",
        "$description": "Durasi transisi maksimal; menjadi 0 bila prefers-reduced-motion aktif"
      }
    },
    "icon": {
      "stroke-width": {
        "$type": "number",
        "$value": 1.5,
        "$description": "Tebal garis ikon pada kisi 24"
      },
      "size": { "$type": "dimension", "$value": 24, "$description": "Ukuran ikon baku" },
      "size-table": {
        "$type": "dimension",
        "$value": 20,
        "$description": "Ukuran ikon dalam tabel"
      }
    },
    "font": {
      "family-sans": {
        "$type": "fontFamily",
        "$value": "{primitive.font-family.sans}",
        "$description": "Keluarga huruf utama"
      }
    },
    "type": {
      "screen-title": {
        "size": {
          "$type": "dimension",
          "$app": {
            "pos": "{primitive.font-size.24}",
            "bo": "{primitive.font-size.22}",
            "owner": "{primitive.font-size.20}"
          },
          "$description": "Judul layar"
        },
        "weight": { "$type": "fontWeight", "$value": "{primitive.font-weight.semibold}" },
        "line-height": { "$type": "number", "$value": "{primitive.line-height.130}" }
      },
      "section-title": {
        "size": {
          "$type": "dimension",
          "$app": {
            "pos": "{primitive.font-size.18}",
            "bo": "{primitive.font-size.16}",
            "owner": "{primitive.font-size.16}"
          },
          "$description": "Judul bagian"
        },
        "weight": { "$type": "fontWeight", "$value": "{primitive.font-weight.semibold}" },
        "line-height": { "$type": "number", "$value": "{primitive.line-height.135}" }
      },
      "body": {
        "size": {
          "$type": "dimension",
          "$app": {
            "pos": "{primitive.font-size.16}",
            "bo": "{primitive.font-size.14}",
            "owner": "{primitive.font-size.16}"
          },
          "$description": "Isi"
        },
        "weight": { "$type": "fontWeight", "$value": "{primitive.font-weight.regular}" },
        "line-height": { "$type": "number", "$value": "{primitive.line-height.150}" }
      },
      "label": {
        "size": {
          "$type": "dimension",
          "$app": {
            "pos": "{primitive.font-size.14}",
            "bo": "{primitive.font-size.12}",
            "owner": "{primitive.font-size.13}"
          },
          "$description": "Label kecil dan keterangan"
        },
        "weight": { "$type": "fontWeight", "$value": "{primitive.font-weight.regular}" },
        "line-height": { "$type": "number", "$value": "{primitive.line-height.140}" }
      },
      "value": {
        "size": {
          "$type": "dimension",
          "$app": {
            "pos": "{primitive.font-size.20}",
            "bo": "{primitive.font-size.14}",
            "owner": "{primitive.font-size.18}"
          },
          "$description": "Harga dan jumlah, angka tabular"
        },
        "weight": { "$type": "fontWeight", "$value": "{primitive.font-weight.medium}" },
        "line-height": { "$type": "number", "$value": "{primitive.line-height.130}" }
      },
      "total": {
        "size": {
          "$type": "dimension",
          "$app": {
            "pos": "{primitive.font-size.32}",
            "bo": "{primitive.font-size.24}",
            "owner": "{primitive.font-size.32}"
          },
          "$description": "Total tagihan, angka tabular"
        },
        "weight": { "$type": "fontWeight", "$value": "{primitive.font-weight.bold}" },
        "line-height": { "$type": "number", "$value": "{primitive.line-height.120}" }
      }
    }
  },
  "component": {
    "button": {
      "height": {
        "$type": "dimension",
        "$app": { "pos": 52, "bo": 40, "owner": 52 },
        "$description": "Tinggi tombol utama"
      },
      "pay-height": {
        "$type": "dimension",
        "$value": 72,
        "$description": "Tinggi tombol Bayar pada POS"
      },
      "radius": { "$type": "dimension", "$value": "{semantic.radius.control}" },
      "primary-bg": { "$type": "color", "$value": "{semantic.color.accent.default}" },
      "primary-bg-pressed": { "$type": "color", "$value": "{semantic.color.accent.pressed}" },
      "primary-text": { "$type": "color", "$value": "{semantic.color.text.on-accent}" },
      "secondary-bg": { "$type": "color", "$value": "{semantic.color.bg.surface}" },
      "secondary-bg-pressed": { "$type": "color", "$value": "{semantic.color.bg.pressed}" },
      "secondary-border-color": { "$type": "color", "$value": "{semantic.color.text.primary}" },
      "secondary-border-width": { "$type": "dimension", "$value": 1 },
      "secondary-text": { "$type": "color", "$value": "{semantic.color.text.primary}" },
      "danger-bg": {
        "$type": "color",
        "$value": "{semantic.color.bg.surface}",
        "$dark": "{semantic.color.status.danger.bg}",
        "$source": "asumsi (nilai gelap)"
      },
      "danger-bg-pressed": {
        "$type": "color",
        "$value": "{semantic.color.status.danger.bg}",
        "$dark": "{primitive.color.white}",
        "$source": "asumsi (nilai gelap)"
      },
      "danger-border-color": { "$type": "color", "$value": "{semantic.color.status.danger.fg}" },
      "danger-border-width": { "$type": "dimension", "$value": 2 },
      "danger-text": { "$type": "color", "$value": "{semantic.color.status.danger.fg}" },
      "disabled-bg": { "$type": "color", "$value": "{semantic.color.bg.disabled}" },
      "disabled-text": { "$type": "color", "$value": "{semantic.color.text.secondary}" }
    },
    "input": {
      "height": {
        "$type": "dimension",
        "$app": { "pos": 52, "bo": 40, "owner": 52 },
        "$description": "Tinggi kolom input"
      },
      "radius": { "$type": "dimension", "$value": "{semantic.radius.control}" },
      "bg": { "$type": "color", "$value": "{semantic.color.bg.surface}" },
      "border-color": { "$type": "color", "$value": "{semantic.color.text.secondary}" },
      "border-width": { "$type": "dimension", "$value": 1 },
      "border-color-focus": { "$type": "color", "$value": "{semantic.color.text.primary}" },
      "border-width-focus": { "$type": "dimension", "$value": 2 },
      "border-color-error": {
        "$type": "color",
        "$value": "{semantic.color.status.danger.fg}",
        "$dark": "{semantic.color.status.danger.bg}",
        "$source": "asumsi (nilai gelap)"
      },
      "border-width-error": { "$type": "dimension", "$value": 2 }
    },
    "table": {
      "header-height": { "$type": "dimension", "$value": 44 },
      "header-bg": { "$type": "color", "$value": "{semantic.color.bg.table-header}" },
      "row-height": {
        "$type": "dimension",
        "$app": { "pos": 48, "bo": 40 },
        "$description": "Tinggi baris tabel"
      },
      "selected-bar-width": { "$type": "dimension", "$value": 4 },
      "selected-bar-color": { "$type": "color", "$value": "{semantic.color.accent.default}" },
      "selected-bg": { "$type": "color", "$value": "{semantic.color.bg.selected}" },
      "border-color": { "$type": "color", "$value": "{semantic.color.border.default}" }
    },
    "chip": {
      "height": {
        "$type": "dimension",
        "$app": { "pos": 48, "bo": 32, "owner": 32 },
        "$description": "Tinggi chip"
      },
      "radius": { "$type": "dimension", "$value": "{semantic.radius.chip}" },
      "font-size": { "$type": "dimension", "$value": "{primitive.font-size.14}" },
      "border-color": {
        "$type": "color",
        "$value": "{semantic.color.text.secondary}",
        "$source": "asumsi"
      },
      "selected-bg": {
        "$type": "color",
        "$value": "{semantic.color.text.primary}",
        "$dark": "{semantic.color.accent.default}",
        "$source": "klien; nilai gelap dari pratinjau halaman 11"
      },
      "selected-text": {
        "$type": "color",
        "$value": "{primitive.color.white}",
        "$dark": "{semantic.color.text.on-accent}"
      }
    },
    "banner": {
      "height-min": { "$type": "dimension", "$value": 28 },
      "height-max": { "$type": "dimension", "$value": 56 }
    },
    "modal": {
      "width-min": { "$type": "dimension", "$value": 400 },
      "width-max": { "$type": "dimension", "$value": 500 },
      "radius": { "$type": "dimension", "$value": "{semantic.radius.modal}" },
      "overlay-bg": { "$type": "color", "$value": "{semantic.color.bg.overlay}" }
    },
    "toast": {
      "height": { "$type": "dimension", "$value": 48 },
      "offset-bottom": { "$type": "dimension", "$value": "{primitive.space.4}" },
      "duration": { "$type": "duration", "$value": "{primitive.duration.toast}" }
    },
    "badge": { "height": { "$type": "dimension", "$value": 24 } },
    "card": {
      "padding": { "$type": "dimension", "$value": "{semantic.space.card-padding}" },
      "radius": { "$type": "dimension", "$value": "{semantic.radius.card}" },
      "border-color": { "$type": "color", "$value": "{semantic.color.border.default}" }
    },
    "topbar": {
      "height": {
        "$type": "dimension",
        "$app": { "pos": 56, "bo": 60, "owner": 56 },
        "$description": "Tinggi bilah atas"
      }
    },
    "sidebar": {
      "width": {
        "$type": "dimension",
        "$value": 240,
        "$description": "Lebar menu kiri Back-Office"
      }
    },
    "bottombar": {
      "height": { "$type": "dimension", "$value": 64, "$description": "Tinggi bilah bawah Owner" }
    }
  },
  "contrast": {
    "limits": { "normal": 4.5, "primary-pos": 7, "non-text": 3 },
    "pairs": [
      {
        "name": "Teks utama pada latar halaman",
        "theme": "light",
        "class": "primary-pos",
        "fg": "{semantic.color.text.primary}",
        "bg": "{semantic.color.bg.page}",
        "spec": 14.92
      },
      {
        "name": "Teks utama pada permukaan",
        "theme": "light",
        "class": "primary-pos",
        "fg": "{semantic.color.text.primary}",
        "bg": "{semantic.color.bg.surface}",
        "spec": 16.39
      },
      {
        "name": "Teks sekunder pada latar halaman",
        "theme": "light",
        "class": "normal",
        "fg": "{semantic.color.text.secondary}",
        "bg": "{semantic.color.bg.page}",
        "spec": 5.28
      },
      {
        "name": "Teks sekunder pada permukaan",
        "theme": "light",
        "class": "normal",
        "fg": "{semantic.color.text.secondary}",
        "bg": "{semantic.color.bg.surface}",
        "spec": 5.8
      },
      {
        "name": "Teks putih pada aksen aksi utama",
        "theme": "light",
        "class": "normal",
        "fg": "{component.button.primary-text}",
        "bg": "{component.button.primary-bg}",
        "spec": 5.42,
        "themed": true
      },
      {
        "name": "Teks putih pada aksen tekan",
        "theme": "light",
        "class": "normal",
        "fg": "{component.button.primary-text}",
        "bg": "{component.button.primary-bg-pressed}",
        "spec": 7.18,
        "themed": true
      },
      {
        "name": "Sukses pada permukaan",
        "theme": "light",
        "class": "normal",
        "fg": "{semantic.color.status.success.fg}",
        "bg": "{semantic.color.bg.surface}",
        "spec": 5.32
      },
      {
        "name": "Sukses pada latar sukses",
        "theme": "light",
        "class": "normal",
        "fg": "{semantic.color.status.success.fg}",
        "bg": "{semantic.color.status.success.bg}",
        "spec": 4.61
      },
      {
        "name": "Peringatan pada latar peringatan",
        "theme": "light",
        "class": "normal",
        "fg": "{semantic.color.status.warning.fg}",
        "bg": "{semantic.color.status.warning.bg}",
        "spec": 5.66
      },
      {
        "name": "Bahaya pada permukaan",
        "theme": "light",
        "class": "normal",
        "fg": "{semantic.color.status.danger.fg}",
        "bg": "{semantic.color.bg.surface}",
        "spec": 6.54
      },
      {
        "name": "Bahaya pada latar bahaya",
        "theme": "light",
        "class": "normal",
        "fg": "{semantic.color.status.danger.fg}",
        "bg": "{semantic.color.status.danger.bg}",
        "spec": 5.58
      },
      {
        "name": "Aksen pada latar halaman (tautan)",
        "theme": "light",
        "class": "normal",
        "fg": "{semantic.color.accent.default}",
        "bg": "{semantic.color.bg.page}",
        "spec": 4.93,
        "themed": true
      },
      {
        "name": "Gelap: teks pada latar",
        "theme": "dark",
        "class": "normal",
        "fg": "{semantic.color.text.primary}",
        "bg": "{semantic.color.bg.page}",
        "spec": 14.57
      },
      {
        "name": "Gelap: sekunder pada latar",
        "theme": "dark",
        "class": "normal",
        "fg": "{semantic.color.text.secondary}",
        "bg": "{semantic.color.bg.page}",
        "spec": 6.74
      },
      {
        "name": "Gelap: aksen pada latar",
        "theme": "dark",
        "class": "normal",
        "fg": "{semantic.color.accent.default}",
        "bg": "{semantic.color.bg.page}",
        "spec": 6.68,
        "themed": true
      },
      {
        "name": "Teks nonaktif pada tombol (dikecualikan)",
        "theme": "light",
        "class": "exempt",
        "fg": "{component.button.disabled-text}",
        "bg": "{component.button.disabled-bg}",
        "spec": 4.29
